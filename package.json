{
  "name": "yourspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "node scripts/cloudflare.mjs preview",
    "deploy": "node scripts/cloudflare.mjs deploy",
    "cf-typegen": "node scripts/cloudflare.mjs types",
    "db:migrate:local": "node scripts/cloudflare.mjs migrate-local",
    "db:migrate:remote": "node scripts/cloudflare.mjs migrate-remote",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup.mjs",
    "setup:local": "node scripts/setup.mjs --local",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260612.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsonc-parser": "^3.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.100.0"
  },
  "description": "An open-source, subscriber-gated personal feed — clone it, brand it, deploy it to Cloudflare.",
  "engines": {
    "node": ">=22.13.0"
  },
  "cloudflare": {
    "bindings": {
      "ADMIN_PASSWORD": {
        "description": "Choose a long, unique password for /admin."
      },
      "SESSION_SECRET": {
        "description": "Generate a random signing key with `openssl rand -base64 48`."
      },
      "DB": {
        "description": "Stores your profile, posts, subscribers, and comments."
      },
      "MEDIA": {
        "description": "Stores uploaded photos and videos. Keep this bucket private."
      }
    }
  }
}
