# Required for /admin and signed sessions. The deploy button asks for these.
# For local development, npm run setup:local generates secure values in .dev.vars.
# For the CLI deployment wizard, npm run setup generates and uploads them.
ADMIN_PASSWORD=
SESSION_SECRET=

# Optional: enable email subscriptions after the first deployment.
# Add these to .dev.vars for local use and as Worker secrets in production.
# RESEND_API_KEY=re_your_real_api_key
# TURNSTILE_SECRET_KEY=your_real_turnstile_secret_key
# Set RESEND_FROM_EMAIL and NEXT_PUBLIC_TURNSTILE_SITE_KEY in Wrangler vars too.
# Use a verified Resend sending domain and production Turnstile keys.
